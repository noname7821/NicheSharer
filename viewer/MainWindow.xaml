<Window x:Class="NicheShareViewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NicheShare Viewer" Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#0A0A0F" Foreground="#F1F5F9"
        FontFamily="Segoe UI" KeyDown="Window_KeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="Purple" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#BF5AF2" Offset="0"/>
            <GradientStop Color="#8B5CF6" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="DarkBox" TargetType="TextBox">
            <Setter Property="Background" Value="#121316"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
        <Style x:Key="MainBtn" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Purple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="GhostBtn" TargetType="Button" BasedOn="{StaticResource MainBtn}">
            <Setter Property="Background" Value="#1C1D21"/>
            <Setter Property="BorderBrush" Value="#27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="130"/>
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="NicheShare" FontSize="20" FontWeight="ExtraBold"/>
            <TextBlock Text=" Viewer" FontSize="20" FontWeight="ExtraBold" Foreground="#BF5AF2"/>
            <TextBlock Text="  server:" VerticalAlignment="Center" Foreground="#71717A" Margin="16,0,6,0"/>
            <TextBox x:Name="ServerBox" Width="220" Style="{StaticResource DarkBox}" FontSize="12"
                     Text="http://localhost:3001"/>
            <TextBlock Text="  code:" VerticalAlignment="Center" Foreground="#71717A" Margin="12,0,6,0"/>
            <TextBox x:Name="CodeBox" Width="110" Style="{StaticResource DarkBox}" MaxLength="6"
                     HorizontalContentAlignment="Center" FontFamily="Consolas"/>
            <Button x:Name="ConnectBtn" Content="Connect" Style="{StaticResource MainBtn}" Margin="12,0,0,0" Click="Connect_Click"/>
            <Button x:Name="UsbBtn" Content="Connect USB" Style="{StaticResource GhostBtn}" Margin="8,0,0,0" Click="UsbConnect_Click"/>
            <Button x:Name="LeaveBtn" Content="Leave" Style="{StaticResource GhostBtn}" Margin="8,0,0,0"
                    Visibility="Collapsed" Click="Leave_Click"/>
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,12,0,12">
            <Ellipse x:Name="Dot" Width="9" Height="9" Fill="#52525B" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="Not connected" Margin="8,0,0,0" Foreground="#A1A1AA" FontWeight="SemiBold"/>
        </StackPanel>

        <!-- Screen lives in its own window -->
        <Border Grid.Row="2" Background="Black" CornerRadius="14" BorderBrush="#27272A" BorderThickness="1"
                MinHeight="120">
            <TextBlock Text="Screen opens in its own window after connect."
                       Foreground="#52525B" HorizontalAlignment="Center" VerticalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" Margin="16"/>
        </Border>

        <!-- Log -->
        <DockPanel Grid.Row="3" Margin="0,12,0,0">
            <Button Content="Copy logs" Style="{StaticResource GhostBtn}" DockPanel.Dock="Bottom"
                    Margin="0,6,0,0" HorizontalAlignment="Right" Click="CopyLogs_Click"/>
            <ListBox x:Name="LogBox" Background="#121316" Foreground="#71717A"
                     BorderBrush="#27272A" FontFamily="Consolas" FontSize="11"/>
        </DockPanel>
    </Grid>
</Window>
